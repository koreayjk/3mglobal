# ─────────────────────────────────────────────────────────
# Recall 서버 환경변수 (Vercel > Settings > Environment Variables 에 입력)
# 이 파일은 값이 비어 있는 예시입니다. 실제 키는 .env 또는 배포 서비스에만 넣고
# 절대 커밋하지 마세요. VITE_ 접두사 변수는 브라우저 번들에 포함되므로
# 비밀 값(API 키, 접근 코드)을 넣으면 안 됩니다.
# ─────────────────────────────────────────────────────────

# AI 제공자: anthropic | openai | mock   (비워 두면 AI 기능 비활성)
AI_PROVIDER=
# 사용할 모델 이름 (제공자 문서의 현재 모델 ID)
AI_MODEL=
# 제공자별 API 키 (사용하는 쪽만)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OpenAI 호환 서버를 쓸 때만 (예: https://api.openai.com/v1)
AI_BASE_URL=
# 선택: 추론 강도 low|medium|high (Anthropic)
AI_EFFORT=

# ── 남용·비용 보호 (모두 선택, 기본값 있음) ──
# 완전 차단 스위치: false 면 AI 비활성
AI_ENABLED=
# 설정하면 앱 설정 화면에서 같은 코드를 입력한 사용자만 AI 사용 가능
AI_ACCESS_CODE=
# 허용 출처(쉼표 구분). 비우면 같은 도메인만 허용. GitHub Pages 등 다른 도메인에서 호출할 때 지정
AI_ALLOWED_ORIGINS=
# 1회 응답 최대 토큰 (기본 6000)
AI_MAX_OUTPUT_TOKENS=
# 요청당 최대 페이지/이미지/글자수 (기본 12 / 6 / 60000)
AI_MAX_PAGES=
AI_MAX_IMAGES=
AI_MAX_TEXT_CHARS=
# IP당 시간당 요청 수 (기본 20), 서버 인스턴스당 하루 총 요청 수 (기본 300)
AI_RATE_LIMIT_PER_HOUR=
AI_DAILY_REQUEST_CAP=

# ── 프론트엔드 (비밀 아님) ──
# GitHub Pages 등 정적 호스팅에서 별도 AI 서버를 쓸 때 그 서버의 주소 (예: https://my-recall.vercel.app)
VITE_AI_API_BASE=
# 하위 경로에 배포할 때 (예: /3mglobal/recall/)
VITE_BASE=
